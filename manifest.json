{
  "manifest_version": 2,
  "name": "Zotero TaskFlow",
  "version": "12.6.3",
  "description": "Turn literature reading into trackable tasks and plans.",
  "homepage_url": "https://github.com/groele/Zotero-TaskFlow",
  "author": "groele",
  "icons": {
    "48": "icon.png",
    "96": "icon@2x.png"
  },
  "applications": {
    "zotero": {
      "id": "todolist@groele.org",
      "strict_min_version": "10.0.0",
      "strict_max_version": "15.*",
      "update_url": "https://raw.githubusercontent.com/groele/Zotero-TaskFlow/main/update.json"
    }
  },
  "browser_specific_settings": {
    "zotero": {
      "id": "todolist@groele.org",
      "strict_min_version": "10.0.0",
      "strict_max_version": "15.*",
      "update_url": "https://raw.githubusercontent.com/groele/Zotero-TaskFlow/main/update.json"
    }
  }
}
